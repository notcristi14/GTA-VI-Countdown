<Application x:Class="GtaViCountdownWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDeep" Color="#120914"/>
        <SolidColorBrush x:Key="BgPanel" Color="#1A0A2E"/>
        <SolidColorBrush x:Key="BgPanelAlt" Color="#12081D"/>
        <SolidColorBrush x:Key="PinkHot" Color="#FF59B7"/>
        <SolidColorBrush x:Key="PinkSoft" Color="#F4C8FF"/>
        <SolidColorBrush x:Key="PinkBorder" Color="#FF8CC8"/>
        <SolidColorBrush x:Key="CyanGlow" Color="#69E9FF"/>
        <SolidColorBrush x:Key="PurpleGlow" Color="#B77BFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#D8B4FE"/>

        <LinearGradientBrush x:Key="GtaNeonBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0716" Offset="0"/>
            <GradientStop Color="#1A0A2E" Offset="0.45"/>
            <GradientStop Color="#120B1E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GtaHeaderGlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1C0C2F" Offset="0"/>
            <GradientStop Color="#2C123F" Offset="0.5"/>
            <GradientStop Color="#170A27" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GtaLogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF69B4" Offset="0"/>
            <GradientStop Color="#FF4DB1" Offset="0.35"/>
            <GradientStop Color="#B65CFF" Offset="0.7"/>
            <GradientStop Color="#5DD8FF" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GtaLogoMark" TargetType="TextBlock">
            <Setter Property="Text" Value="VI"/>
            <Setter Property="FontFamily" Value="Segoe UI Black, Arial Black, Impact"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{StaticResource GtaLogoGradient}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PinkSoft}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource PinkBorder}"
                                BorderThickness="0,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#38FF69B4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FF69B4"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#1A0F26"/>
            <Setter Property="Foreground" Value="#F8D8FF"/>
            <Setter Property="BorderBrush" Value="#7F5CFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="true">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalContentAlignment="Right"
                                                  ClickMode="Press">
                                        <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" Stroke="#F5C8FF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </ToggleButton>
                                    <ContentPresenter Margin="10,0,22,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#1B0E2A" BorderBrush="#FF7EC9" BorderThickness="1" CornerRadius="8" MinWidth="180">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
