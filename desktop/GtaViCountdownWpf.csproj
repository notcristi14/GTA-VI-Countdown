<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>GtaViCountdown</AssemblyName>
    <RootNamespace>GtaViCountdownWpf</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>notcristi14</Authors>
    <Product>GTA VI Countdown</Product>
    <Description>Desktop wrapper for the GTA VI regional countdown — Eastern Europe</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GtaLogo.png" />
    <Resource Include="Assets\GtaLogo.svg" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
